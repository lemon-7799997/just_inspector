{
  "name": "@just-inspector/inspector-ui",
  "version": "0.1.0",
  "description": "Vue 3 inspector UI: node tree, property grid and input controls (text, number, slider, dropdown, checkbox, color, curve, vector, JSON).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json --emitDeclarationOnly",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@just-inspector/client": "*",
    "@just-inspector/protocol": "*",
    "vue": "^3.5.0",
    "vue-color-kit": "^1.0.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.0"
  }
}
